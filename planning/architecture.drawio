<mxfile host="app.diagrams.net" version="24.0.0">
  <diagram name="Architecture" id="arch1">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1200" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- TITLE -->
        <mxCell id="title" value="Self-Hosted MiniMax-H3 (33B video + audio) on an 8 GB GPU — Architecture &amp; Flow" style="text;html=1;align=center;verticalAlign=middle;fontSize=20;fontStyle=1;fontColor=#1a1a2e;" vertex="1" parent="1">
          <mxGeometry x="80" y="20" width="1440" height="46" as="geometry" />
        </mxCell>

        <!-- COLUMN HEADERS -->
        <mxCell id="hStack" value="THE STACK  (foundation, bottom → top)" style="text;html=1;align=center;verticalAlign=middle;fontSize=15;fontStyle=1;fontColor=#31507a;" vertex="1" parent="1">
          <mxGeometry x="60" y="80" width="320" height="30" as="geometry" />
        </mxCell>
        <mxCell id="hFlow" value="GENERATION FLOW  (prompt → video)" style="text;html=1;align=center;verticalAlign=middle;fontSize=15;fontStyle=1;fontColor=#3f7040;" vertex="1" parent="1">
          <mxGeometry x="620" y="80" width="360" height="30" as="geometry" />
        </mxCell>
        <mxCell id="hOpt" value="KEY OPTIMIZATIONS  (why 8 GB works)" style="text;html=1;align=center;verticalAlign=middle;fontSize=15;fontStyle=1;fontColor=#9a7d18;" vertex="1" parent="1">
          <mxGeometry x="1200" y="80" width="360" height="30" as="geometry" />
        </mxCell>

        <!-- ===================== STACK COLUMN ===================== -->
        <mxCell id="s1" value="Hardware&#10;RTX 3060 Ti — 8 GB VRAM&#10;60 GB RAM  ·  NVMe SSD" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=13;verticalAlign=middle;spacing=10;" vertex="1" parent="1">
          <mxGeometry x="60" y="130" width="320" height="80" as="geometry" />
        </mxCell>
        <mxCell id="s2" value="OS &amp; Runtime&#10;Ubuntu 26.04  ·  NVIDIA driver 595 / CUDA 13&#10;Python 3.12 (uv)  ·  PyTorch 2.11 (cu128)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=13;verticalAlign=middle;spacing=10;" vertex="1" parent="1">
          <mxGeometry x="60" y="240" width="320" height="80" as="geometry" />
        </mxCell>
        <mxCell id="s3" value="Engine&#10;ComfyUI 0.30&#10;(runs as a systemd service, auto-restart)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=13;verticalAlign=middle;spacing=10;" vertex="1" parent="1">
          <mxGeometry x="60" y="350" width="320" height="80" as="geometry" />
        </mxCell>
        <mxCell id="s4" value="Custom Nodes (add-ons)&#10;GGUF · KJNodes · Turbo-LoRA · sol-attn&#10;ClipProj · RIFE · FaceRestore · mem_probe" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=13;verticalAlign=middle;spacing=10;" vertex="1" parent="1">
          <mxGeometry x="60" y="460" width="320" height="90" as="geometry" />
        </mxCell>
        <!-- stack arrows -->
        <mxCell id="se1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#6c8ebf;endArrow=block;" edge="1" parent="1" source="s1" target="s2"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="se2" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#6c8ebf;endArrow=block;" edge="1" parent="1" source="s2" target="s3"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="se3" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#6c8ebf;endArrow=block;" edge="1" parent="1" source="s3" target="s4"><mxGeometry relative="1" as="geometry" /></mxCell>

        <!-- stack note -->
        <mxCell id="sNote" value="The model (~46 GB of weights) does NOT fit in 8 GB VRAM.&#10;ComfyUI streams it layer-by-layer from the 60 GB RAM.&#10;VRAM is a small working buffer, not the model's home." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#999999;fontSize=12;verticalAlign=middle;spacing=10;dashed=1;" vertex="1" parent="1">
          <mxGeometry x="60" y="590" width="320" height="90" as="geometry" />
        </mxCell>

        <!-- ===================== FLOW COLUMN ===================== -->
        <mxCell id="f1" value="① Your prompt (text)&#10;&quot;a woman singing on a rooftop…&quot;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=13;verticalAlign=middle;spacing=10;" vertex="1" parent="1">
          <mxGeometry x="620" y="130" width="360" height="70" as="geometry" />
        </mxCell>
        <mxCell id="f2" value="② Text / Vision Encoder&#10;Qwen3-VL-32B  →  &quot;conditioning&quot;&#10;(reads the prompt into meaning vectors)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=13;verticalAlign=middle;spacing=10;" vertex="1" parent="1">
          <mxGeometry x="620" y="230" width="360" height="80" as="geometry" />
        </mxCell>
        <mxCell id="f3" value="③ Start from random noise&#10;(a compressed &apos;latent&apos;, 16× smaller in space)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=13;verticalAlign=middle;spacing=10;" vertex="1" parent="1">
          <mxGeometry x="620" y="340" width="360" height="70" as="geometry" />
        </mxCell>
        <mxCell id="f4" value="④ DiT — 33B Transformer  (the generator)&#10;DENOISE LOOP × 6 steps (Turbo)&#10;video + audio sculpted together, guided by ②" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=13;fontStyle=1;verticalAlign=middle;spacing=10;" vertex="1" parent="1">
          <mxGeometry x="620" y="440" width="360" height="90" as="geometry" />
        </mxCell>
        <mxCell id="f5" value="⑤ Clean latent  (the finished &apos;dream&apos;, still compressed)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=13;verticalAlign=middle;spacing=10;" vertex="1" parent="1">
          <mxGeometry x="620" y="560" width="360" height="60" as="geometry" />
        </mxCell>
        <mxCell id="f6" value="⑥ VAE decode  →  video frames  +  32 kHz stereo audio&#10;(expands the latent back into real pixels &amp; sound)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=13;verticalAlign=middle;spacing=10;" vertex="1" parent="1">
          <mxGeometry x="620" y="650" width="360" height="80" as="geometry" />
        </mxCell>
        <mxCell id="f7" value="⑦ RIFE frame interpolation&#10;24 → 48 fps  (smooth motion)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=13;verticalAlign=middle;spacing=10;" vertex="1" parent="1">
          <mxGeometry x="620" y="760" width="360" height="70" as="geometry" />
        </mxCell>
        <mxCell id="f8" value="⑧ Upscale — 4x-UltraSharp&#10;→ 720p / 1080p" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=13;verticalAlign=middle;spacing=10;" vertex="1" parent="1">
          <mxGeometry x="620" y="860" width="360" height="70" as="geometry" />
        </mxCell>
        <mxCell id="f9" value="⑨ Face restore — GFPGAN&#10;rebuild small / background faces" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=13;verticalAlign=middle;spacing=10;" vertex="1" parent="1">
          <mxGeometry x="620" y="960" width="360" height="70" as="geometry" />
        </mxCell>
        <mxCell id="f10" value="⑩ Mux (ffmpeg)  →  final MP4  🎬" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=14;fontStyle=1;verticalAlign=middle;spacing=10;" vertex="1" parent="1">
          <mxGeometry x="620" y="1060" width="360" height="60" as="geometry" />
        </mxCell>
        <!-- flow arrows -->
        <mxCell id="fe1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#82b366;endArrow=block;" edge="1" parent="1" source="f1" target="f2"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="fe2" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#82b366;endArrow=block;" edge="1" parent="1" source="f2" target="f3"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="fe3" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#82b366;endArrow=block;" edge="1" parent="1" source="f3" target="f4"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="fe4" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#d79b00;endArrow=block;" edge="1" parent="1" source="f4" target="f5"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="fe5" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#82b366;endArrow=block;" edge="1" parent="1" source="f5" target="f6"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="fe6" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#82b366;endArrow=block;" edge="1" parent="1" source="f6" target="f7"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="fe7" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#82b366;endArrow=block;" edge="1" parent="1" source="f7" target="f8"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="fe8" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#82b366;endArrow=block;" edge="1" parent="1" source="f8" target="f9"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="fe9" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#82b366;endArrow=block;" edge="1" parent="1" source="f9" target="f10"><mxGeometry relative="1" as="geometry" /></mxCell>

        <!-- ===================== OPTIMIZATION COLUMN ===================== -->
        <mxCell id="o1" value="Weights streamed from RAM&#10;46 GB model → streamed layer-by-layer&#10;through the 8 GB VRAM." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;verticalAlign=middle;spacing=10;" vertex="1" parent="1">
          <mxGeometry x="1200" y="130" width="360" height="80" as="geometry" />
        </mxCell>
        <mxCell id="o2" value="⭐ int8 matmul chunk patch&#10;Frees ~2 GB, bit-identical output.&#10;Raised 15 s native ceiling 576×320 → 768×448 (1.87× pixels)." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;fontStyle=1;verticalAlign=middle;spacing=10;" vertex="1" parent="1">
          <mxGeometry x="1200" y="430" width="360" height="100" as="geometry" />
        </mxCell>
        <mxCell id="o3" value="Turbo-LoRA&#10;20 → 6 sampling steps (~5× faster)." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;verticalAlign=middle;spacing=10;" vertex="1" parent="1">
          <mxGeometry x="1200" y="550" width="360" height="60" as="geometry" />
        </mxCell>
        <mxCell id="o4" value="ClipProj (optional)&#10;Swap 32B encoder → 4B + projection.&#10;−27% time, half the RAM, comparable quality." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;verticalAlign=middle;spacing=10;" vertex="1" parent="1">
          <mxGeometry x="1200" y="240" width="360" height="80" as="geometry" />
        </mxCell>
        <mxCell id="o5" value="RIFE → smooth motion&#10;Fixes the &apos;jitter when a character moves&apos;." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;verticalAlign=middle;spacing=10;" vertex="1" parent="1">
          <mxGeometry x="1200" y="760" width="360" height="70" as="geometry" />
        </mxCell>
        <mxCell id="o6" value="Face restore (GFPGAN)&#10;Rebuilds melty small faces.&#10;Root cause = low native res on 8 GB;&#10;full fix = native 768p on a bigger GPU." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;verticalAlign=middle;spacing=10;" vertex="1" parent="1">
          <mxGeometry x="1200" y="920" width="360" height="110" as="geometry" />
        </mxCell>
        <!-- dashed links from optimizations to flow steps -->
        <mxCell id="oe1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#d6b656;dashed=1;endArrow=open;" edge="1" parent="1" source="o4" target="f2"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="oe2" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#d6b656;dashed=1;endArrow=open;" edge="1" parent="1" source="o2" target="f4"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="oe3" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#d6b656;dashed=1;endArrow=open;" edge="1" parent="1" source="o3" target="f4"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="oe4" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#d6b656;dashed=1;endArrow=open;" edge="1" parent="1" source="o5" target="f7"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="oe5" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#d6b656;dashed=1;endArrow=open;" edge="1" parent="1" source="o6" target="f9"><mxGeometry relative="1" as="geometry" /></mxCell>

        <!-- link stack to flow (engine drives the flow) -->
        <mxCell id="link1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#6c8ebf;dashed=1;endArrow=open;" edge="1" parent="1" source="s3" target="f4"><mxGeometry relative="1" as="geometry" /></mxCell>

