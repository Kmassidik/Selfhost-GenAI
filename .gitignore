# ---- never commit: model weights, engines, media, caches, secrets ----
# All huge, downloadable, or regenerable — the runtime lives on the box.

# weights + adapters + binaries
models/
loras/
upscale/
*.safetensors
*.gguf
*.pt
*.pth
*.pickle

# generated media + render state
outputs/
state/
logs/
*.log
*.mp4
*.mov
*.wav
*.png
*.jpg

# third-party / cloned engines — not ours to redistribute
runtime/h3-consumer-bench/
runtime/h3-consumer-bench/h3-lab/
h3-lab/
_archive/

# envs + caches
.venv/
venv/
__pycache__/
*.pyc
.ipynb_checkpoints/
.DS_Store

# secrets — never
*.token
.hf_token
id_*
*.pem
.env
secrets*

# operational handover — names where credentials live, stays local
handover/

# exception: the benchmark comparison strips are cited by knowledge-base ch.51
!knowledge-base/assets/bench/*.jpg
